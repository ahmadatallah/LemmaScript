// Generated by lsc from jsMath.ts

function MathAbs(x: int): nat { if x >= 0 then x else -x }

function MathMin(a: int, b: int): int { if a <= b then a else b }

function MathMax(a: int, b: int): int { if a >= b then a else b }

function clampDays(n: int): int
{
  MathMin(MathMax(LO, n), HI)
}

lemma clampDays_ensures(n: int)
  ensures (clampDays(n) >= LO)
  ensures (clampDays(n) <= HI)
  ensures ((n >= LO) ==> (n <= HI) ==> (clampDays(n) == n))
{
}

function distance(a: int, b: int): int
{
  MathAbs((a - b))
}

lemma distance_ensures(a: int, b: int)
  ensures (distance(a, b) >= 0)
  ensures ((distance(a, b) == (a - b)) || (distance(a, b) == (b - a)))
{
}

const LO: int := 1

const HI: int := 256
